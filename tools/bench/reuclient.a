; C64 side of reuspans.py. IRQs off. The loop stashes a page to the REU, fetches it
; back to another page and compares, counting rounds and mismatches; a CIA2 timer
; NMI, once the bench starts it, stores to $D418 for locked slices to start on.
; Every REU register write is read back before the transfer starts. A register that
; reads back wrong is counted, the value a second read found is kept, and the write is
; repeated until it holds: a lost write reads back what the last transfer left there,
; which for $DF02, $DF04 and $DF06 is the value being written, so their lost writes
; go uncounted.
* = $0801
!word next, 10
!byte $9e
!text "2064"
!byte 0
next !word 0

ready  = $c104          ; $5A once set up
rounds = $c110          ; 16 bits
errors = $c112          ; 16 bits
seed   = $c114
misslo = $c120          ; per register $DF02-$DF08: read-back misses, low bytes
misshi = $c128          ; and high bytes
lastrd = $c130          ; the value a second read found after the last miss
source = $4000
dest   = $5000

reu_cmd  = $df01
reu_regs = $df02        ; C64 address, REU address and bank, length: 7 registers
stash    = $90          ; execute now, C64 to REU
fetch    = $91          ; execute now, REU to C64

* = $0810
        sei
        lda #$7f
        sta $dc0d
        sta $dd0d
        lda $dc0d
        lda $dd0d
        lda #0
        sta $d01a
        sta rounds
        sta rounds+1
        sta errors
        sta errors+1
        sta seed
        ldx #$17
-       sta misslo,x
        dex
        bpl -
        lda #<nmi
        sta $0318
        lda #>nmi
        sta $0319
        lda #$5a
        sta ready

loop    inc seed
        ldx #0
-       txa
        eor seed
        sta source,x
        inx
        bne -
        lda #>source
        ldy #stash
        jsr transfer
        lda #>dest
        ldy #fetch
        jsr transfer
        ldx #0
-       lda dest,x
        cmp source,x
        bne bad
        inx
        bne -
        inc rounds
        bne loop
        inc rounds+1
        jmp loop
bad     inc errors
        bne loop
        inc errors+1
        jmp loop

; A = C64 page, Y = command. 256 bytes at REU address 0; every register is
; written each time, since a transfer leaves them advanced.
transfer
        sta regs+1
        lda #0
        sta regs
        sta regs+2
        sta regs+3
        sta regs+4
        sta regs+5
        lda #1
        sta regs+6
        ldx #6
store   lda regs,x
        sta reu_regs,x
        cmp reu_regs,x
        beq +
        lda reu_regs,x
        sta lastrd,x
        inc misslo,x
        bne store
        inc misshi,x
        jmp store
+       dex
        bpl store
        sty reu_cmd
        rts

regs    !fill 7

nmi     pha
        lda $dd0d
        lda #$0f
        sta $d418
        pla
        rti
