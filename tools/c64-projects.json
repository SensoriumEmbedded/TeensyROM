{
  "projects": [
    {
      "name": "MainMenuCRT",
      "description": "Main TeensyROM menu, built as a headerless cartridge ROM image at $8000. Its header has no PROGMEM: it must sit in RAM for ROM emulation.",
      "dir": "Source/C64/MainMenuCRT",
      "steps": [
        { "assembler": "acme", "source": "source/MainMenu.asm", "output": "MainMenu.bin", "format": "plain", "report": "MainBuildReport", "labels": "MainSymbols" },
        { "assembler": "acme", "source": "source/TeensyROMC64.asm", "output": "TeensyROMC64.bin", "format": "plain", "report": "CartBuildReport", "labels": "CartSymbols" }
      ],
      "headers": [
        { "input": "build/TeensyROMC64.bin", "dest": "TeensyROMC64.h", "progmem": false }
      ]
    },
    {
      "name": "SettingsMenu",
      "description": "TeensyROM settings/configuration menu",
      "dir": "Source/C64/SettingsMenu",
      "steps": [
        { "assembler": "acme", "source": "source/SettingsMenu.asm", "output": "SettingsMenu.prg", "format": "cbm" }
      ],
      "headers": [
        { "input": "build/SettingsMenu.prg", "dest": "SettingsMenu.prg.h", "progmem": true }
      ]
    },
    {
      "name": "TRHelpScreens",
      "description": "Help screens shown from the TeensyROM menu",
